# Скопируйте этот файл в .env: cp .env.example .env
# Ключ Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Модель Gemini (необязательно, по умолчанию gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Порт локального сервера (необязательно, по умолчанию 3000)
PORT=3000
